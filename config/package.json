{
  "name": "Karaoke_Studio",
  "version": "1.0.0",
  "versionName": "Karaoke Studio",
  "description": "An AI-powered desktop karaoke application featuring automated vocal separation, precise WhisperX timestamp synchronization, synchronized bouncing ball lyrics, and library management.",
  "main": "main.py",
  "author": "Sandra van Buggenum | SnowY4you",
  "copyright": "Copyright © 2026 SnowY4you",
  "license": "MIT",
  "repository": {
    "type": "github",
    "url": "https://github.com/SnowY4you/Karaoke_Studio"
  },
  "keywords": [
    "karaoke",
    "ai",
    "vocal-remover",
    "whisperx",
    "uvr5",
    "pyqt6",
    "lyrics-sync",
    "bouncing-ball",
    "music-player"
  ],
  "scripts": {
    "start": "python main.py",
    "build": "pyinstaller --noconfirm --onedir --windowed --add-data \"assets;assets\" --add-data \"config;config\" main.py",
    "lint": "flake8 src/",
    "clean-cache": "python -c \"import shutil, os; shutil.rmtree('storage/cache', ignore_errors=True); os.makedirs('storage/cache', exist_ok=True)\""
  },
  "fonts": {
    "primary": "Arial",
    "primary_bold": "Arial Bold"
  },
  "dependencies": {
    "python": ">=3.10,<3.13",
    "PyQt6": "^6.6.0",
    "python-vlc": "^3.0.18000",
    "torch": "^2.1.0",
    "whisperx": "latest",
    "audio-separator": "^0.17.0",
    "moviepy": "^1.0.3",
    "numpy": "^1.24.0"
  }
}